# Clave de la API de Claude (console.anthropic.com). Nunca la subas al repositorio.
ANTHROPIC_API_KEY=

# Lemon Squeezy: tienda que vende los planes y emite las licencias.
LEMONSQUEEZY_STORE_ID=

# Una variante de producto por plan (el plan gratis es un producto de 0 $).
LEMONSQUEEZY_VARIANT_GRATIS=
LEMONSQUEEZY_VARIANT_EMPRENDEDOR=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_AGENCIA=

# Enlaces de pago de cada plan.
NEXT_PUBLIC_CHECKOUT_GRATIS=
NEXT_PUBLIC_CHECKOUT_EMPRENDEDOR=
NEXT_PUBLIC_CHECKOUT_PRO=
NEXT_PUBLIC_CHECKOUT_AGENCIA=

# Solo para desarrollo local: una licencia de prueba (plan Emprendedor) que no pasa por Lemon Squeezy.
DEV_LICENSE_KEY=
